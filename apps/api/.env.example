DATABASE_URL="postgresql://user:password@localhost:5433/ca_tient?schema=public"
# Integration tests wipe tables: they use DATABASE_URL_TEST, or DATABASE_URL with a "_test" database name.
# Create that database once, then `pnpm test` migrates it automatically.
# DATABASE_URL_TEST="postgresql://user:password@localhost:5433/ca_tient_test?schema=public"
PORT=3001
WEB_APP_URL="http://localhost:3000"
# Behind a reverse proxy (production), trust it so rate limiting sees the real client IP:
# a hop count ("1"), "true", or subnets ("loopback, 10.0.0.0/8"). Leave unset locally.
TRUST_PROXY=""
# AI providers, tried in order: Gemini -> Groq -> Mistral (a provider without key is skipped).
# Add _2 ... _10 suffixes to rotate several keys of the same provider when one hits its quota.
# Gemini quotas are per Google Cloud project: keys from the same project share one quota.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
# Payments: "test" approves at once (development only, refused when NODE_ENV=production), "fedapay" for real payments.
PAYMENT_PROVIDER="test"
# FedaPay (required when PAYMENT_PROVIDER=fedapay): secret API key and the webhook signing secret from the dashboard.
FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
