generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessModel {
  ECOMMERCE
  FORMATION
  EBOOK
  SERVICE
  PRODUIT_PHYSIQUE
  AUTRE
}

model Idea {
  id             String        @id @default(cuid())
  businessModel  BusinessModel
  rawDescription String
  currency       String
  createdAt      DateTime      @default(now())
  hypotheses     Hypothesis[]
  simulations    Simulation[]
  canvasBlocks   CanvasBlock[]
  accessTokenHash String?
  paidAt          DateTime?
  payments        Payment[]
}

model Hypothesis {
  id     String  @id @default(cuid())
  ideaId String
  idea   Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  key    String
  label  String
  value  Int
  unit   String?
  source String

  @@unique([ideaId, key])
}

model Simulation {
  id             String   @id @default(cuid())
  ideaId         String
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  type           String
  inputsSnapshot Json
  result         Json
  breakEven      Json
  createdAt      DateTime @default(now())
}

model CanvasBlock {
  id      String @id @default(cuid())
  ideaId  String
  idea    Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  key     String
  content String
  source  CanvasBlockSource

  @@unique([ideaId, key])
}

enum CanvasBlockSource {
  ia_suggere
  utilisateur_edite
}

enum PaymentProvider {
  test
  fedapay
}

enum PaymentStatus {
  pending
  approved
  declined
  canceled
}

model Payment {
  id                    String          @id @default(cuid())
  ideaId                String
  idea                  Idea            @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  providerTransactionId String?
  amount                Int
  currency              String
  status                PaymentStatus   @default(pending)
  createdAt             DateTime        @default(now())
  confirmedAt           DateTime?

  @@unique([provider, providerTransactionId])
  @@index([ideaId])
}
